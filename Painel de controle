<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Painel de Controle · Defin Digital</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{--ink:#0f172a;--ink-soft:#64748b;--cyan:#0ea5b7;--cyan-soft:#e0f7fa;--bg:#f4f6f8;--surface:#fff;--surface2:#f8fafc;--border:#e2e8f0;--ok:#0ea5b7;--pending:#f59e0b;--radius:14px}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Inter',sans-serif}
h1,h2,h3,.topbar-brand{font-family:'Space Grotesk',sans-serif}
.loading-screen{height:100vh;display:flex;align-items:center;justify-content:center;color:var(--ink-soft)}
.login-screen{height:100vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#0f172a,#1e293b)}
.login-card{background:var(--surface);border-radius:20px;padding:40px 36px;width:340px;box-shadow:0 20px 60px rgba(0,0,0,.35)}
.login-logo{color:var(--cyan);font-weight:700;letter-spacing:.08em;font-size:13px;margin-bottom:8px}
.login-card h1{font-size:22px;margin:0 0 4px}
.login-sub{color:var(--ink-soft);font-size:13px;margin-bottom:24px}
.login-card label{display:block;font-size:13px;color:var(--ink-soft);margin-bottom:14px}
.login-card input{width:100%;margin-top:6px;padding:10px 12px;border-radius:10px;border:1px solid var(--border);font-size:14px}
.login-card button{width:100%;margin-top:8px;padding:12px;border:none;border-radius:10px;background:var(--ink);color:#fff;font-weight:600;cursor:pointer}
.login-error{color:#dc2626;font-size:13px;margin-bottom:10px}
.shell{max-width:1040px;margin:0 auto;padding:24px 20px 60px}
.topbar{display:flex;align-items:center;gap:16px;padding:14px 0;margin-bottom:18px;border-bottom:1px solid var(--border);flex-wrap:wrap}
.topbar-brand{font-weight:700;letter-spacing:.04em;font-size:15px}
.topbar-client{font-weight:600;color:var(--ink-soft)}
.topbar select{margin-left:auto;padding:8px 10px;border-radius:8px;border:1px solid var(--border)}
.logout-btn{margin-left:auto;background:none;border:1px solid var(--border);border-radius:8px;padding:8px 14px;cursor:pointer;color:var(--ink-soft);font-size:13px}
.client-links{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px}
.client-links a{text-decoration:none;background:var(--surface2);border:1px solid var(--border);padding:8px 14px;border-radius:999px;font-size:13px;color:var(--ink)}
.month-switch,.tabs{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap}
.month-switch button,.tabs button{border:1px solid var(--border);background:var(--surface);padding:8px 16px;border-radius:999px;cursor:pointer;font-size:13px;color:var(--ink-soft)}
.month-switch button.active,.tabs button.active{background:var(--ink);color:#fff;border-color:var(--ink)}
.add-btn{border:1px dashed var(--cyan) !important;color:var(--cyan) !important;background:none}
.panel{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px 22px;margin-bottom:18px}
.panel h3{margin:0 0 12px;font-size:16px}
.panel-sub{color:var(--ink-soft);font-size:13px;margin:0 0 12px}
.panel textarea{width:100%;border:1px solid var(--border);border-radius:10px;padding:10px 12px;font-family:inherit;font-size:14px;resize:vertical}
.panel button.save{margin-top:10px;padding:10px 18px;border:none;border-radius:8px;background:var(--cyan);color:#fff;font-weight:600;cursor:pointer}
.admin-summary-text{white-space:pre-wrap;line-height:1.6}
.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:16px}
.metric-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px}
.metric-label{font-size:12px;color:var(--ink-soft);margin-bottom:6px}
.metric-value{font-size:24px;font-weight:700;font-family:'Space Grotesk',sans-serif}
.metric-value span{font-size:14px;color:var(--ink-soft);font-weight:500}
.progress-bar-outer{height:8px;background:var(--border);border-radius:999px;margin-top:10px;overflow:hidden}
.progress-bar-outer.small{height:5px;margin-top:8px}
.progress-bar-inner{height:100%;background:var(--cyan);border-radius:999px}
.status-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}
.status-pill{display:flex;align-items:center;gap:8px;padding:8px 14px;border-radius:999px;background:var(--surface2);border:1px solid var(--border);font-size:13px}
.status-pill .dot{width:8px;height:8px;border-radius:50%;background:var(--pending)}
.status-pill.ok .dot{background:var(--ok)}
.status-pill.ok{color:var(--ok)}
.calendar-list{display:flex;flex-direction:column;gap:8px}
.calendar-row{display:grid;grid-template-columns:110px 100px 90px 1fr 100px;gap:10px;align-items:center;padding:10px 12px;background:var(--surface2);border-radius:10px;font-size:13px}
.calendar-row.editable{grid-template-columns:140px 120px 110px 1fr 120px}
.calendar-row input,.calendar-row select{border:1px solid var(--border);border-radius:6px;padding:6px 8px;font-size:13px}
.calendar-status{padding:4px 10px;border-radius:999px;text-align:center;font-size:12px}
.status-planejado{background:#fef3c7;color:#b45309}
.status-publicado{background:var(--cyan-soft);color:var(--cyan)}
.checklist-list{display:flex;flex-direction:column;gap:6px}
.checklist-row{display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--surface2);border-radius:10px;font-size:13px}
.checklist-row.clickable{cursor:pointer}
.checklist-row.done{opacity:.6;text-decoration:line-through}
.checklist-check{color:var(--cyan);font-weight:700}
.admin-field-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:16px}
.field-label{display:block;font-size:12px;color:var(--ink-soft);margin-bottom:14px}
.field-label input,.field-label textarea{width:100%;margin-top:6px;padding:8px 10px;border-radius:8px;border:1px solid var(--border);font-size:14px;font-family:inherit}
.check-field{display:flex;align-items:center;gap:8px;font-size:13px}
.empty-state{text-align:center;color:var(--ink-soft);padding:60px 20px}
@media (max-width:720px){.metric-grid,.admin-field-grid{grid-template-columns:repeat(2,1fr)}.calendar-row,.calendar-row.editable{grid-template-columns:1fr}}
</style>
</head>
<body>
<div id="app"><div class="loading-screen">Carregando...</div></div>

<script>
// ======================================================
// 1) CONFIGURAÇÃO — troque pelos dados do SEU projeto Supabase
// ======================================================
const SUPABASE_URL = "https://ahgcsxmzrspodeqmdxex.supabase.co";
const SUPABASE_ANON_KEY = "sb_publishable_-TfPgmAUTCrYwx7Ch-Ac1Q_YU_1_hHO";

const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
const CHANNEL_LABEL = {instagram:"Instagram",facebook:"Facebook",linkedin:"LinkedIn",tiktok:"TikTok",site:"Site"};
const TYPE_LABEL = {post:"Post",story:"Story",reel:"Reel",artigo:"Artigo"};
const SOCIAL_PLATFORMS = [["instagram","Instagram"],["facebook","Facebook"],["linkedin","LinkedIn"]];
const SOCIAL_FIELDS = [["followers","Seguidores totais"],["new_followers","Novos seguidores"],["growth_pct","Crescimento (%)"],["views","Visualizações"],["link_clicks","Cliques no link"],["interactions","Interações"]];
const app = document.getElementById("app");

let state = { session:null, profile:null, clients:[], selectedClientId:null, months:[], selectedMonth:null, checklist:[], calendarPosts:[], socialInsights:{}, tab:"resumo", adminTab:"entregaveis" };

async function init(){
  const { data:{ session } } = await sb.auth.getSession();
  state.session = session;
  if (session) await loadProfile();
  sb.auth.onAuthStateChange(async (_e, session) => {
    state.session = session;
    if (session) { await loadProfile(); } else { state.profile = null; render(); }
  });
  render();
}

async function loadProfile(){
  const { data } = await sb.from("profiles").select("*, clients(*)").eq("id", state.session.user.id).single();
  state.profile = data;
  if (data && data.role === "admin") await loadClients();
  if (data && data.role === "client") await loadClientData(data.client_id);
  render();
}

// ---------- ADMIN DATA ----------
async function loadClients(){
  const { data } = await sb.from("clients").select("*").order("name");
  state.clients = data || [];
  if (!state.selectedClientId && state.clients.length) state.selectedClientId = state.clients[0].id;
  if (state.selectedClientId) await loadMonthsFor(state.selectedClientId, true);
}
async function loadMonthsFor(clientId, isAdmin){
  const { data } = await sb.from("deliverable_months").select("*").eq("client_id", clientId).order("month_label");
  state.months = data || [];
  state.selectedMonth = state.months.length ? state.months[state.months.length-1] : null;
  const { data:cl } = await sb.from("checklist_items").select("*").eq("client_id", clientId).order("sort_order");
  state.checklist = cl || [];
  if (state.selectedMonth) {
    await loadCalendar(state.selectedMonth.id);
    await loadSocialInsights(state.selectedMonth.id);
    if (isAdmin) await ensureSocialInsightRows(state.selectedMonth.id, clientId);
  }
}
async function loadCalendar(monthId){
  const { data } = await sb.from("calendar_posts").select("*").eq("deliverable_month_id", monthId).order("post_date");
  state.calendarPosts = data || [];
}

async function loadSocialInsights(monthId){
  const { data } = await sb.from("social_insights").select("*").eq("deliverable_month_id", monthId);
  state.socialInsights = {};
  SOCIAL_PLATFORMS.forEach(([key]) => {
    state.socialInsights[key] = (data||[]).find(d => d.platform === key) || null;
  });
}

async function ensureSocialInsightRows(monthId, clientId){
  for (const [key] of SOCIAL_PLATFORMS){
    if (!state.socialInsights[key]){
      const { data, error } = await sb.from("social_insights").insert({
        client_id: clientId, deliverable_month_id: monthId, platform: key
      }).select().single();
      if (!error) state.socialInsights[key] = data;
    }
  }
}

// ---------- CLIENT DATA ----------
async function loadClientData(clientId){
  const { data } = await sb.from("deliverable_months").select("*").eq("client_id", clientId).order("month_label");
  state.months = data || [];
  state.selectedMonth = state.months.length ? state.months[state.months.length-1] : null;
  const { data: cl } = await sb.from("checklist_items").select("*").eq("client_id", clientId).order("sort_order");
  state.checklist = cl || [];
  if (state.selectedMonth) {
    await loadCalendar(state.selectedMonth.id);
    await loadSocialInsights(state.selectedMonth.id);
  }
}

function pct(done, target){ if(!target) return 0; return Math.min(100, Math.round((done/target)*100)); }

// ---------- RENDER ----------
function render(){
  if (!state.session) return renderLogin();
  if (!state.profile) return app.innerHTML = '<div class="loading-screen">Carregando perfil...</div>';
  if (state.profile.role === "admin") return renderAdmin();
  return renderClient();
}

function renderLogin(){
  app.innerHTML = `
    <div class="login-screen"><div class="login-card">
      <div class="login-logo">DEFIN DIGITAL</div>
      <h1>Painel de Controle</h1>
      <p class="login-sub">Acesse com seu e-mail e senha.</p>
      <form id="loginForm">
        <label>E-mail<input type="email" id="loginEmail" required></label>
        <label>Senha<input type="password" id="loginPass" required></label>
        <div id="loginError" class="login-error"></div>
        <button type="submit">Entrar</button>
      </form>
    </div></div>`;
  document.getElementById("loginForm").onsubmit = async (e) => {
    e.preventDefault();
    const email = document.getElementById("loginEmail").value;
    const password = document.getElementById("loginPass").value;
    const { error } = await sb.auth.signInWithPassword({ email, password });
    if (error) document.getElementById("loginError").textContent = "E-mail ou senha incorretos.";
  };
}

function topbarHtml(isAdmin){
  if (isAdmin){
    const opts = state.clients.map(c => `<option value="${c.id}" ${c.id===state.selectedClientId?"selected":""}>${c.name}</option>`).join("");
    return `<div class="topbar"><div class="topbar-brand">DEFIN DIGITAL · Admin</div>
      <select id="clientSelect">${opts}</select>
      <button class="logout-btn" id="logoutBtn">Sair</button></div>`;
  }
  const c = state.profile.clients;
  return `<div class="topbar"><div class="topbar-brand">DEFIN DIGITAL</div>
    <div class="topbar-client">${c.name}</div>
    <button class="logout-btn" id="logoutBtn">Sair</button></div>`;
}

function monthSwitchHtml(isAdmin){
  const btns = state.months.map(m => `<button data-month="${m.id}" class="${state.selectedMonth && m.id===state.selectedMonth.id?"active":""}">${m.month_label}</button>`).join("");
  return `<div class="month-switch">${btns}${isAdmin ? '<button class="add-btn" id="addMonthBtn">+ Mês</button>' : ""}</div>`;
}

function checklistPct(){
  const total = state.checklist.length, done = state.checklist.filter(c=>c.done).length;
  return { total, done, pct: total ? Math.round(done/total*100) : 0 };
}

// ---------- CLIENT VIEW ----------
function renderClient(){
  const c = state.profile.clients;
  if (!state.selectedMonth){
    app.innerHTML = topbarHtml(false) + '<div class="shell"><div class="empty-state">Ainda não há dados cadastrados para este cliente.</div></div>';
    bindCommon(false); return;
  }
  const m = state.selectedMonth;
  const links = [["site_url","🌐 Site"],["instagram_url","📷 Instagram"],["facebook_url","👍 Facebook"],["linkedin_url","💼 LinkedIn"],["tiktok_url","🎵 TikTok"]]
    .filter(([k]) => c[k]).map(([k,label]) => `<a href="${c[k]}" target="_blank">${label}</a>`).join("");
  const cp = checklistPct();

  let tabContent = "";
  if (state.tab === "resumo"){
    tabContent = `
      <div class="metric-grid">
        ${metricCard("Posts", m.posts_done, m.posts_target)}
        ${metricCard("Stories", m.stories_done, m.stories_target)}
        ${metricCard("Reels", m.reels_done, m.reels_target)}
        ${metricCard("LinkedIn", m.linkedin_done, m.linkedin_target)}
      </div>
      <div class="status-row">
        ${statusPill("Site", m.site_done)}${statusPill("Gestão de redes", m.gestao_done)}
        ${statusPill("Relatório mensal", m.relatorio_done)}
      </div>
      <div class="panel"><h3>O que foi feito neste mês</h3>
        <p class="admin-summary-text">${m.admin_summary || "Ainda sem resumo cadastrado para este mês."}</p></div>
      <div class="panel"><h3>Seu comentário</h3>
        <p class="panel-sub">Deixe aqui alguma observação, dúvida ou feedback sobre este mês.</p>
        <textarea id="commentBox" rows="4" placeholder="Escreva seu comentário...">${m.client_comment || ""}</textarea>
        <button class="save" id="saveCommentBtn">Salvar comentário</button></div>`;
  } else if (state.tab === "calendario"){
    tabContent = `<div class="panel"><h3>Calendário de publicações — ${m.month_label}</h3>
      ${state.calendarPosts.length===0 ? '<p class="panel-sub">Nenhuma publicação cadastrada neste mês ainda.</p>' : ""}
      <div class="calendar-list">${state.calendarPosts.map(p => `
        <div class="calendar-row">
          <div>${new Date(p.post_date+"T00:00:00").toLocaleDateString("pt-BR")}</div>
          <div>${CHANNEL_LABEL[p.channel]||p.channel}</div>
          <div>${TYPE_LABEL[p.type]||p.type}</div>
          <div>${p.title||""}</div>
          <div class="calendar-status status-${p.status}">${p.status==="publicado"?"Publicado":"Planejado"}</div>
        </div>`).join("")}</div></div>`;
  } else if (state.tab === "redes"){
    tabContent = SOCIAL_PLATFORMS.map(([key,label]) => socialCardHtml(key, label, state.socialInsights[key], false)).join("");
  } else if (state.tab === "checklist"){
    tabContent = `<div class="panel"><h3>Planejamento estratégico</h3>
      <div class="progress-bar-outer"><div class="progress-bar-inner" style="width:${cp.pct}%"></div></div>
      <p class="panel-sub">${cp.done} de ${cp.total} etapas concluídas (${cp.pct}%)</p>
      <div class="checklist-list">${state.checklist.map(it => `
        <div class="checklist-row ${it.done?"done":""}">
          <span class="checklist-check">${it.done?"✔":"○"}</span><span>${it.title}</span>
        </div>`).join("")}</div></div>`;
  }

  app.innerHTML = topbarHtml(false) + `<div class="shell">
    <div class="client-links">${links}</div>
    ${monthSwitchHtml(false)}
    <div class="tabs">
      <button data-tab="resumo" class="${state.tab==="resumo"?"active":""}">Resumo</button>
      <button data-tab="calendario" class="${state.tab==="calendario"?"active":""}">Calendário</button>
      <button data-tab="redes" class="${state.tab==="redes"?"active":""}">Redes sociais</button>
      <button data-tab="checklist" class="${state.tab==="checklist"?"active":""}">Planejamento</button>
    </div>
    ${tabContent}
  </div>`;
  bindCommon(false);

  const saveBtn = document.getElementById("saveCommentBtn");
  if (saveBtn) saveBtn.onclick = async () => {
    const text = document.getElementById("commentBox").value;
    await sb.from("deliverable_months").update({ client_comment:text }).eq("id", m.id);
    m.client_comment = text;
    saveBtn.textContent = "Salvo!"; setTimeout(()=>saveBtn.textContent="Salvar comentário", 1500);
  };
}

function metricCard(label, done, target){
  return `<div class="metric-card"><div class="metric-label">${label}</div>
    <div class="metric-value">${done||0}<span>/${target||0}</span></div>
    <div class="progress-bar-outer small"><div class="progress-bar-inner" style="width:${pct(done,target)}%"></div></div></div>`;
}
function statusPill(label, done){
  return `<div class="status-pill ${done?"ok":""}"><span class="dot"></span>${label}</div>`;
}

// ---------- ADMIN VIEW ----------
function renderAdmin(){
  if (!state.clients.length){
    app.innerHTML = topbarHtml(true) + '<div class="shell"><div class="empty-state">Cadastre um cliente na tabela "clients" do Supabase para começar.</div></div>';
    bindCommon(true); return;
  }
  const m = state.selectedMonth;
  let tabContent = "";
  if (m && state.adminTab === "entregaveis"){
    tabContent = `<div class="panel"><h3>Entregáveis — ${m.month_label}</h3>
      <div class="admin-field-grid">
        ${numField("posts_done","Posts feitos",m.posts_done)}${numField("posts_target","Posts meta",m.posts_target)}
        ${numField("stories_done","Stories feitos",m.stories_done)}${numField("stories_target","Stories meta",m.stories_target)}
        ${numField("reels_done","Reels feitos",m.reels_done)}${numField("reels_target","Reels meta",m.reels_target)}
        ${numField("linkedin_done","LinkedIn feitos",m.linkedin_done)}${numField("linkedin_target","LinkedIn meta",m.linkedin_target)}
      </div>
      <div class="status-row">
        ${checkField("site_done","Site",m.site_done)}${checkField("gestao_done","Gestão de redes",m.gestao_done)}
        ${checkField("relatorio_done","Relatório mensal",m.relatorio_done)}
      </div></div>`;
  } else if (m && state.adminTab === "calendario"){
    tabContent = `<div class="panel"><h3>Calendário — ${m.month_label}</h3>
      <button class="add-btn" id="addPostBtn" style="padding:8px 16px;border-radius:999px;margin-bottom:12px">+ Publicação</button>
      <div class="calendar-list">${state.calendarPosts.map(p => `
        <div class="calendar-row editable">
          <input type="date" data-post="${p.id}" data-field="post_date" value="${p.post_date}">
          <select data-post="${p.id}" data-field="channel">
            ${["instagram","facebook","linkedin","tiktok","site"].map(c=>`<option value="${c}" ${p.channel===c?"selected":""}>${CHANNEL_LABEL[c]}</option>`).join("")}
          </select>
          <select data-post="${p.id}" data-field="type">
            ${["post","story","reel","artigo"].map(t=>`<option value="${t}" ${p.type===t?"selected":""}>${TYPE_LABEL[t]}</option>`).join("")}
          </select>
          <input type="text" data-post="${p.id}" data-field="title" value="${p.title||""}">
          <select data-post="${p.id}" data-field="status">
            <option value="planejado" ${p.status==="planejado"?"selected":""}>Planejado</option>
            <option value="publicado" ${p.status==="publicado"?"selected":""}>Publicado</option>
          </select>
        </div>`).join("")}</div></div>`;
  } else if (m && state.adminTab === "redes"){
    tabContent = SOCIAL_PLATFORMS.map(([key,label]) => socialCardHtml(key, label, state.socialInsights[key], true)).join("");
  } else if (state.adminTab === "checklist"){
    tabContent = `<div class="panel"><h3>Checklist do planejamento</h3>
      <div class="checklist-list">${state.checklist.map(it => `
        <div class="checklist-row clickable ${it.done?"done":""}" data-check="${it.id}">
          <span class="checklist-check">${it.done?"✔":"○"}</span><span>${it.title}</span>
        </div>`).join("")}</div></div>`;
  } else if (m && state.adminTab === "resumo"){
    tabContent = `<div class="panel"><h3>Resumo do mês para o cliente</h3>
      <label class="field-label">O que foi feito neste mês<textarea id="summaryBox" rows="6">${m.admin_summary||""}</textarea></label>
      <button class="save" id="saveSummaryBtn">Salvar resumo</button>
      <h3 style="margin-top:24px">Comentário do cliente</h3>
      <p class="panel-sub">${m.client_comment || "O cliente ainda não comentou neste mês."}</p></div>`;
  }

  app.innerHTML = topbarHtml(true) + `<div class="shell">
    ${monthSwitchHtml(true)}
    <div class="tabs">
      <button data-admintab="entregaveis" class="${state.adminTab==="entregaveis"?"active":""}">Entregáveis</button>
      <button data-admintab="calendario" class="${state.adminTab==="calendario"?"active":""}">Calendário</button>
      <button data-admintab="redes" class="${state.adminTab==="redes"?"active":""}">Redes sociais</button>
      <button data-admintab="checklist" class="${state.adminTab==="checklist"?"active":""}">Checklist</button>
      <button data-admintab="resumo" class="${state.adminTab==="resumo"?"active":""}">Resumo / Cliente</button>
    </div>
    ${tabContent || '<div class="empty-state">Cadastre um mês para este cliente ("+ Mês") para começar.</div>'}
  </div>`;
  bindCommon(true);
  bindAdminHandlers();
}

function socialCardHtml(platformKey, label, data, editable){
  if (!data){
    return `<div class="panel"><h3>${label}</h3><p class="panel-sub">Sem dados cadastrados para este período.</p></div>`;
  }
  if (editable){
    return `<div class="panel"><h3>${label}</h3>
      <div class="admin-field-grid">
        ${SOCIAL_FIELDS.map(([f,lbl]) => `<label class="field-label">${lbl}<input type="number" step="${f==="growth_pct"?"0.1":"1"}" data-social="${platformKey}" data-field="${f}" value="${data[f]||0}"></label>`).join("")}
      </div>
      <label class="field-label">Anotações<textarea data-social="${platformKey}" data-field="note" rows="3">${data.note||""}</textarea></label>
    </div>`;
  }
  return `<div class="panel"><h3>${label}</h3>
    <div class="metric-grid">
      ${SOCIAL_FIELDS.map(([f,lbl]) => `<div class="metric-card"><div class="metric-label">${lbl}</div><div class="metric-value">${f==="growth_pct" ? (data[f]||0)+"%" : (data[f]||0)}</div></div>`).join("")}
    </div>
    <p class="admin-summary-text">${data.note ? data.note : "Sem anotações para este período."}</p>
  </div>`;
}

function numField(field,label,value){
  return `<label class="field-label">${label}<input type="number" data-field="${field}" value="${value||0}"></label>`;
}
function checkField(field,label,value){
  return `<label class="check-field"><input type="checkbox" data-field="${field}" ${value?"checked":""}>${label}</label>`;
}

function bindAdminHandlers(){
  document.querySelectorAll("[data-field]").forEach(el => {
    if (el.closest(".calendar-row") || el.dataset.social) return;
    el.onchange = async () => {
      const field = el.dataset.field;
      const value = el.type === "checkbox" ? el.checked : (el.type === "number" ? Number(el.value) : el.value);
      state.selectedMonth[field] = value;
      await sb.from("deliverable_months").update({ [field]: value }).eq("id", state.selectedMonth.id);
    };
  });
  document.querySelectorAll("[data-social]").forEach(el => {
    el.onchange = async () => {
      const platform = el.dataset.social, field = el.dataset.field;
      const value = field === "note" ? el.value : Number(el.value);
      state.socialInsights[platform][field] = value;
      await sb.from("social_insights").update({ [field]: value }).eq("id", state.socialInsights[platform].id);
    };
  });
  document.querySelectorAll("[data-post]").forEach(el => {
    el.onchange = async () => {
      const id = el.dataset.post, field = el.dataset.field, value = el.value;
      await sb.from("calendar_posts").update({ [field]: value }).eq("id", id);
      const post = state.calendarPosts.find(p => p.id === id);
      if (post) post[field] = value;
    };
  });
  document.querySelectorAll("[data-check]").forEach(el => {
    el.onclick = async () => {
      const item = state.checklist.find(c => c.id === el.dataset.check);
      item.done = !item.done;
      await sb.from("checklist_items").update({ done:item.done }).eq("id", item.id);
      renderAdmin();
    };
  });
  const addMonthBtn = document.getElementById("addMonthBtn");
  if (addMonthBtn) addMonthBtn.onclick = async () => {
    const label = prompt("Mês (ex: 2026-11):");
    if (!label) return;
    const { data, error } = await sb.from("deliverable_months").insert({
      client_id: state.selectedClientId, month_label: label,
      posts_target:26, stories_target:78, linkedin_target:60, reels_target:0
    }).select().single();
    if (!error){
      state.months.push(data); state.selectedMonth = data; state.calendarPosts=[]; state.socialInsights={};
      await ensureSocialInsightRows(data.id, state.selectedClientId);
      renderAdmin();
    } else alert("Erro ao criar mês: " + error.message);
  };
  const addPostBtn = document.getElementById("addPostBtn");
  if (addPostBtn) addPostBtn.onclick = async () => {
    const title = prompt("Título/descrição da publicação:");
    if (!title) return;
    const date = prompt("Data (AAAA-MM-DD):");
    if (!date) return;
    const { data, error } = await sb.from("calendar_posts").insert({
      client_id: state.selectedClientId, deliverable_month_id: state.selectedMonth.id,
      post_date: date, channel:"instagram", type:"post", title, status:"planejado"
    }).select().single();
    if (!error){ state.calendarPosts.push(data); renderAdmin(); }
    else alert("Erro ao criar publicação: " + error.message);
  };
  const saveSummaryBtn = document.getElementById("saveSummaryBtn");
  if (saveSummaryBtn) saveSummaryBtn.onclick = async () => {
    const text = document.getElementById("summaryBox").value;
    await sb.from("deliverable_months").update({ admin_summary:text }).eq("id", state.selectedMonth.id);
    state.selectedMonth.admin_summary = text;
    saveSummaryBtn.textContent = "Salvo!"; setTimeout(()=>saveSummaryBtn.textContent="Salvar resumo", 1500);
  };
  const clientSelect = document.getElementById("clientSelect");
  if (clientSelect) clientSelect.onchange = async (e) => {
    state.selectedClientId = e.target.value;
    await loadMonthsFor(state.selectedClientId, true);
    render();
  };
}

function bindCommon(isAdmin){
  document.getElementById("logoutBtn").onclick = () => sb.auth.signOut();
  document.querySelectorAll("[data-month]").forEach(btn => {
    btn.onclick = async () => {
      const month = state.months.find(m => m.id === btn.dataset.month);
      state.selectedMonth = month;
      await loadCalendar(month.id);
      await loadSocialInsights(month.id);
      if (isAdmin) await ensureSocialInsightRows(month.id, state.selectedClientId);
      render();
    };
  });
  document.querySelectorAll("[data-tab]").forEach(btn => {
    btn.onclick = () => { state.tab = btn.dataset.tab; render(); };
  });
  document.querySelectorAll("[data-admintab]").forEach(btn => {
    btn.onclick = () => { state.adminTab = btn.dataset.admintab; render(); };
  });
}

init();
</script>
</body>
</html>
